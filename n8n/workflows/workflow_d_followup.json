{
  "name": "Workflow D — Follow-up (Timer-based)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Interval Trigger (1 Hour)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "FOLLOWUP_DELAY_HOURS", "value": "={{ $env.FOLLOWUP_DELAY_HOURS || '24' }}" },
            { "name": "AIRTABLE_BASE_ID", "value": "={{ $env.AIRTABLE_BASE_ID }}" },
            { "name": "AIRTABLE_LEADS_TABLE", "value": "={{ $env.AIRTABLE_LEADS_TABLE || 'Leads' }}" },
            { "name": "BUSINESS_NAME", "value": "={{ $env.BUSINESS_NAME || 'Apex Elite Plumbing' }}" }
          ]
        },
        "options": {}
      },
      "name": "Config Loader",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.airtable.com/v0/" + $node['Config Loader'].json.AIRTABLE_BASE_ID + "/" + $node['Config Loader'].json.AIRTABLE_LEADS_TABLE + "?filterByFormula=" + encodeURIComponent("OR({Status} = 'Awaiting Response', {Status} = 'Followed Up')"),
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.AIRTABLE_ACCESS_TOKEN }}" }
          ]
        }
      },
      "name": "Query Pending Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.fields.Status }}",
              "value2": "Awaiting Response"
            }
          ]
        }
      },
      "name": "Stage 1: Awaiting Response?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [740, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/" + $node['Config Loader'].json.AIRTABLE_BASE_ID + "/" + $node['Config Loader'].json.AIRTABLE_LEADS_TABLE + "/" + $json.id,
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.AIRTABLE_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"fields\": {\n    \"Status\": \"Followed Up\",\n    \"NextAction\": \"Customer nudge sent; awaiting reply\"\n  }\n}"
      },
      "name": "Update Status: Followed Up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [960, 180]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/" + $node['Config Loader'].json.AIRTABLE_BASE_ID + "/" + $node['Config Loader'].json.AIRTABLE_LEADS_TABLE + "/" + $json.id,
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.AIRTABLE_ACCESS_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"fields\": {\n    \"Status\": \"Escalated to Human\",\n    \"NextAction\": \"Lead unresponsive; human callback required\"\n  }\n}"
      },
      "name": "Update Status: Escalated to Human",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [960, 420]
    }
  ],
  "connections": {
    "Interval Trigger (1 Hour)": {
      "main": [[{ "node": "Config Loader", "type": "main", "index": 0 }]]
    },
    "Config Loader": {
      "main": [[{ "node": "Query Pending Leads", "type": "main", "index": 0 }]]
    },
    "Query Pending Leads": {
      "main": [[{ "node": "Stage 1: Awaiting Response?", "type": "main", "index": 0 }]]
    },
    "Stage 1: Awaiting Response?": {
      "main": [
        [{ "node": "Update Status: Followed Up", "type": "main", "index": 0 }],
        [{ "node": "Update Status: Escalated to Human", "type": "main", "index": 0 }]
      ]
    }
  }
}
