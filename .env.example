# ==============================================================================
# APEX ELITE CONTRACTOR AI PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Add your API keys in the designated sections below.
# 3. Start the application:
#    npm run dev
# ==============================================================================

# ==============================================================================
# 1. [PRIMARY] GOOGLE GEMINI AI (VOICE & LEAD EXTRACTION)
# ==============================================================================
# Powers real-time voice receptionist (Riley) and high-accuracy structured lead extraction.
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
VOICE_ENGINE=gemini

# ==============================================================================
# 2. [PRIMARY] TWILIO SMS & WHATSAPP GATEWAY
# ==============================================================================
# Powers 24/7 inbound SMS & WhatsApp lead capture and customer booking confirmations.
# Sign up and get free $15 trial credits at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15550190000
# For WhatsApp: Use your Twilio Sandbox number (whatsapp:+14155238886) or approved Business sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_TO_TEST_NUMBER=+15550191111

# ==============================================================================
# 3. [OPTIONAL] BUSINESS & DISPATCH PROFILE
# ==============================================================================
# Customize your contractor branding, customer support number, and dispatcher email.
BUSINESS_NAME=Apex Elite Plumbing & Heating
TRADE_TYPE=Plumbing, Heating & Drain Specialists
SUPPORT_PHONE=+15550192834
CONTRACTOR_PHONE=+15550198888
CONTRACTOR_EMAIL=dispatch@apexeliteplumbing.demo

# ==============================================================================
# 4. [OPTIONAL] CLOUD VOICE TELEPHONY (VAPI / RETELL)
# ==============================================================================
# Used if routing inbound phone calls through Vapi cloud voice infrastructure.
# Get credentials at: https://vapi.ai/ or https://retellai.com/
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=+15550109999
RETELL_API_KEY=

# ==============================================================================
# 6. [OPTIONAL] CALENDAR SCHEDULING (CAL.COM)
# ==============================================================================
# External booking sync for contractor dispatch slots.
# Get credentials at: https://cal.com/
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_USERNAME=apex-elite

# ==============================================================================
# 7. [OPTIONAL] DUAL-CLOUD CRM (AIRTABLE)
# ==============================================================================
# Dual-sync to external Airtable base (System already uses built-in SQLite natively).
# Get credentials at: https://airtable.com/create/tokens
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE=Leads
AIRTABLE_LOG_TABLE=Logs

# ==============================================================================
# 8. [OPTIONAL] CONTRACTOR ALERT CHANNELS (SLACK / SMS / EMAIL)
# ==============================================================================
# Set alert channel: slack | sms | email
CONTRACTOR_NOTIFY_CHANNEL=slack
SLACK_WEBHOOK_URL=

# ==============================================================================
# 9. SERVER SETTINGS & AUTOMATION TIMERS
# ==============================================================================
PORT=3000
NODE_ENV=development
# Follow-up nudges and review request delays (in hours)
FOLLOWUP_DELAY_HOURS=24
SECOND_STAGE_DELAY_HOURS=48
